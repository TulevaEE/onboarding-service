<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#FFFFFF" width="660px">
    <mj-include path="./partials/header.mjml" />

    <mj-section padding-top="12px">
      <mj-column>
        <mj-text>Hello,&nbsp;*|FNAME|*</mj-text>
        <mj-text>
          Your payment arrived on *|paymentDate|* and the fund units are in your pension account.
        </mj-text>
        <mj-text>
          Only 30% of people in Estonia save in the third pillar. You are one of them, and you
          are deliberately putting money aside for your future.
        </mj-text>

        <mj-raw>*|IF:hasTulevaUser|*</mj-raw>

        <mj-include path="./partials/suggest_chain_open_en.mjml" />

        <mj-raw>*|END:IF|*</mj-raw>

        <mj-raw>*|ELSE:|*</mj-raw>
        <mj-text>
          You can see how your third pillar and your other pension savings are doing at Tuleva
          whenever you like. You do not need to create a separate account with us, you already
          have one. Just log in:
        </mj-text>
        <mj-button href="https://pension.tuleva.ee/login">Log in</mj-button>
        <mj-raw>*|END:IF|*</mj-raw>
      </mj-column>
    </mj-section>

    <mj-include path="./partials/contact_en.mjml" />
    <mj-section padding="0 24px">
      <mj-column>
        <mj-text padding-top="12px">
          Tõnu Pekk<br />
          Founder and fund manager of Tuleva
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/disclaimer_pension_en.mjml" />
    <mj-include path="./partials/footer_bottom_fund.mjml" />
  </mj-body>
</mjml>
