  local blob
  blob=$(git rev-parse HEAD:Shared.java)
  git checkout --quiet -b feature
  echo "second" >Shared.java
  git add -A && git commit --quiet -m feature >/dev/null 2>&1
  rm -f ".git/objects/${blob:0:2}/${blob:2}"
}

# branch_push_check <description> <expected exit> <expected output|-> <branch setup>
branch_push_check() {
  local description=$1 expected=$2 expected_output=$3 branch_setup=$4
  rm -rf "$TMP/origin.git"
  setup_repo
  REMOTE_SHA=0000000000000000000000000000000000000000
  PUSH_REMOTE=origin
  PUSH_REF=refs/heads/feature
  PUSH_SHA=""
  "$branch_setup"
  [ -n "$PUSH_SHA" ] || PUSH_SHA=$(git rev-parse HEAD)
  local output actual
  output=$(printf '%s %s %s %s\n' "$PUSH_REF" "$PUSH_SHA" "$PUSH_REF" "$REMOTE_SHA" |
    "$PRE_PUSH" "$PUSH_REMOTE" "$TMP/remote" 2>&1)
  actual=$?
  expect_hook_result "$description" "$expected" "$expected_output" "$actual" "$output"
}

