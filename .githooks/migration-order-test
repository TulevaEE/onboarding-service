  1 "could not compute what this commit adds" "$PII_FIXTURE_ID_CODE" lose_the_staged_blob

# The message is published with the commit, so commit-msg scans it like an added
# file. Below git's scissors line sits the diff `commit -v` shows, which
# pre-commit has scanned already and git discards.
#
# message_check <description> <expected exit> <expected output|-> <message line>...
message_check() {
  local description=$1 expected=$2 expected_output=$3
  shift 3
  setup_repo
  printf '%s\n' "$@" >"$TMP/COMMIT_EDITMSG"
  local output actual
  output=$("$COMMIT_MSG_HOOK" "$TMP/COMMIT_EDITMSG" 2>&1)
  actual=$?
  expect_hook_result "$description" "$expected" "$expected_output" "$actual" "$output"
}

