#!/bin/bash
# Self-test for pii-scan. Runs in CI so a regression cannot reach a developer's
# terminal as a raw Perl error or, worse, as a silent pass.
#
# The roster cases use a throwaway roster built from invented names, so this
# file never has to contain anyone's real name to prove name matching works.

set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

cp "$DIR/pii-scan" "$WORK/"
printf 'salt=test-salt\n' > "$WORK/pii-roster.sha256"
# The ASCII entry goes in first and unconditionally. Hashing a non-ASCII name
# is itself broken by the bug this file guards against, and an empty roster
# would skip the name loop entirely — every wide-character case would then pass
# without ever reaching the code that dies.
"$WORK/pii-scan" --hash 'Testnimi Testperenimi' >> "$WORK/pii-roster.sha256"
"$WORK/pii-scan" --hash 'Šeperenimi Žtest' >> "$WORK/pii-roster.sha256" 2>/dev/null

# Throwaway allowlists, so this test never depends on the repo's real ones.
# The IBAN is the SEB test-gateway account already public in the repo's
# fixtures; the ID code is the long-public synthetic sample-user fixture.
printf '# test allowlist\nEE651010220306497226\n' > "$WORK/pii-iban-allow"
printf '# test allowlist\n38812121215\n' > "$WORK/pii-idcode-allow"

if [ "$(grep -cE '^[0-9a-f]{64}$' "$WORK/pii-roster.sha256")" -eq 0 ]; then
  echo "FAIL  setup: roster is empty, so no name case would exercise the scanner"
  exit 1
fi

failures=0

# expect: "clean" (exit 0, no output), "finding" (exit 1), plus never a Perl die
check() {
  local name=$1 expect=$2 line=$3
  local out rc
  out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,1 @@\n+%s\n' "$line" | "$WORK/pii-scan" 2>&1)
  rc=$?

  if printf '%s' "$out" | grep -qE 'Wide character|at .*pii-scan line [0-9]+'; then
    echo "FAIL  $name: perl error instead of a verdict"
    printf '%s\n' "$out" | head -2 | sed 's/^/        /'
    failures=$((failures + 1))
    return
  fi

  case "$expect" in
    clean)   [ "$rc" -eq 0 ] || { echo "FAIL  $name: expected clean, got a finding"; failures=$((failures + 1)); return; } ;;
    finding) [ "$rc" -eq 1 ] || { echo "FAIL  $name: expected a finding, got clean"; failures=$((failures + 1)); return; } ;;
  esac
  echo "ok    $name"
}

# Characters above U+00FF reach Digest::SHA only through the roster loop, and
# it dies on them unless normalise encodes back to bytes. Estonian s and z with
# caron are above U+00FF, so this is not an exotic case here.
check 'greek letter'        clean   '  // Σ(paevased tasud kuus)'
check 's-caron z-caron'     clean   '  String s = "Šefer Žukov";'
check 'cyrillic and CJK'    clean   '  // Кириллица 日本語'
check 'emoji'               clean   '  block.add("👉 Tegevus: kontrolli");'
check 'latin-1 diacritics'  clean   '  String s = "Märt Põder ütles";'

check 'valid id code'       finding '  String c = "38903112710";'
check 'id code inside a hex digest'   clean   '  "requestDigest":"c38903112710b9a1"'
check 'id code glued to letters'     clean   '  ref ab38903112710f'
check 'id code after a colon'        finding '  isikukood:38903112710'
check 'synthetic id code'   clean   '  String c = "38888888888";'
check 'allowlisted id code' clean   '  String c = "38812121215";'
check 'allowlisted then real id code' finding '  process("38812121215", "38903112710");'
check 'invalid then valid id code'    finding '  process("38812121216", "38903112710");'
check 'timestamp'           clean   '  long t = 1786541411606L;'
check 'valid iban'          finding '  String i = "EE382200221020145685";'
check 'allowlisted iban'    clean   '  String i = "EE651010220306497226";'

# The hook wrappers pass the allowlist of the revision being scanned via the
# environment, so a working-tree edit cannot exempt what the commit publishes.
out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,1 @@\n+String i = "EE382200221020145685";\n' \
  | PII_IBAN_ALLOW_SOURCE='EE382200221020145685' "$WORK/pii-scan" 2>&1)
if [ $? -eq 0 ]; then echo "ok    env allowlist overrides file"; else
  echo "FAIL  env allowlist overrides file: expected clean"; failures=$((failures + 1)); fi

out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,1 @@\n+String i = "EE651010220306497226";\n' \
  | PII_IBAN_ALLOW_SOURCE='# nothing allowed' "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    env allowlist replaces file"; else
  echo "FAIL  env allowlist replaces file: expected a finding"; failures=$((failures + 1)); fi

out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,1 @@\n+String c = "38903112710";\n' \
  | PII_IDCODE_ALLOW_SOURCE='38903112710' "$WORK/pii-scan" 2>&1)
if [ $? -eq 0 ]; then echo "ok    id-code env allowlist overrides file"; else
  echo "FAIL  id-code env allowlist overrides file: expected clean"; failures=$((failures + 1)); fi

out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,1 @@\n+String c = "38812121215";\n' \
  | PII_IDCODE_ALLOW_SOURCE='# nothing allowed' "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    id-code env allowlist replaces file"; else
  echo "FAIL  id-code env allowlist replaces file: expected a finding"; failures=$((failures + 1)); fi
check 'personal email'      finding '  String e = "jaan.tamm@tuleva.ee";'
check 'role email'          clean   '  String e = "compliance@tuleva.ee";'
check 'ordinary code'       clean   '  return fundValueRepository.findLastValueForFund(key);'

check 'rostered ascii name'    finding '  block.add("Tegevus — Testnimi Testperenimi.");'
check 'rostered name lowered'  finding '  var owner = "testnimi testperenimi";'
check 'rostered non-ascii name' finding '  block.add("Tegevus — Šeperenimi Žtest.");'

# Growing the allowlist adds a valid-IBAN line; it passes because the same
# commit's allowlist carries the value, not because the path is exempt. Every
# other detector still runs on the allow file, so it cannot smuggle a name.
out=$(printf -- '--- a/.githooks/pii-iban-allow\n+++ b/.githooks/pii-iban-allow\n@@ -0,0 +1,1 @@\n+EE382200221020145685\n' \
  | PII_IBAN_ALLOW_SOURCE='EE382200221020145685' "$WORK/pii-scan" 2>&1)
if [ $? -eq 0 ]; then echo "ok    allow-file growth carries its own exemption"; else
  echo "FAIL  allow-file growth carries its own exemption: expected clean"; failures=$((failures + 1)); fi

out=$(printf -- '--- a/.githooks/pii-iban-allow\n+++ b/.githooks/pii-iban-allow\n@@ -0,0 +1,1 @@\n+# kontakt: Testnimi Testperenimi\n' | "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    allow-file cannot smuggle a rostered name"; else
  echo "FAIL  allow-file cannot smuggle a rostered name: expected a finding"; failures=$((failures + 1)); fi

out=$(printf -- '--- a/.githooks/pii-idcode-allow\n+++ b/.githooks/pii-idcode-allow\n@@ -0,0 +1,1 @@\n+38903112710\n' \
  | PII_IDCODE_ALLOW_SOURCE='38903112710' "$WORK/pii-scan" 2>&1)
if [ $? -eq 0 ]; then echo "ok    id-code allow-file growth carries its own exemption"; else
  echo "FAIL  id-code allow-file growth carries its own exemption: expected clean"; failures=$((failures + 1)); fi

# A file header only counts outside a hunk, so an added line that reads like
# one cannot switch the scan over to this exempt file.
out=$(printf -- '--- a/x\n+++ b/x\n@@ -0,0 +1,2 @@\n+++ b/.githooks/pii-scan-test\n+String c = "38903112710";\n' \
  | "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    added line cannot pose as a file header"; else
  echo "FAIL  added line cannot pose as a file header: expected a finding"; failures=$((failures + 1)); fi

# Git quotes a path it cannot print as is. A quoted header still starts a new
# file, so the exemption of the file before it does not carry over.
out=$(printf -- 'diff --git a/.githooks/pii-scan-test b/.githooks/pii-scan-test\n--- a/.githooks/pii-scan-test\n+++ b/.githooks/pii-scan-test\n@@ -0,0 +1,1 @@\n+x\ndiff --git "a/we\\"ird.java" "b/we\\"ird.java"\n--- /dev/null\n+++ "b/we\\"ird.java"\n@@ -0,0 +1,1 @@\n+String c = "38903112710";\n' \
  | "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    quoted path ends the exempt file"; else
  echo "FAIL  quoted path ends the exempt file: expected a finding"; failures=$((failures + 1)); fi

# diff.suppressBlankEmpty prints an empty context line as an empty line.
out=$(printf -- '--- a/x\n+++ b/x\n@@ -1,1 +1,2 @@\n\n+String c = "38903112710";\n' | "$WORK/pii-scan" 2>&1)
if [ $? -eq 1 ]; then echo "ok    empty context line stays inside the hunk"; else
  echo "FAIL  empty context line stays inside the hunk: expected a finding"; failures=$((failures + 1)); fi

if [ "$failures" -ne 0 ]; then
  echo ""
  echo "$failures pii-scan self-test failure(s)"
  exit 1
fi
echo ""
echo "pii-scan self-test passed"
