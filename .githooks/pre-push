#!/bin/bash
# On a public repository a push is publication, so personal data has to be
# stopped here rather than in CI: by the time a workflow runs, the branch is
# already on GitHub and a later commit cannot unpublish it.

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNBORN=0000000000000000000000000000000000000000
DEFAULT_BRANCH=origin/master

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$UNBORN" ] && continue

  # Compare against the merge base with the default branch, never against the
  # remote tip of this branch. Merging master in would otherwise re-present
  # every file master already carries as newly added, and the push would be
  # blocked by data that is long since public.
  base=$(git merge-base "$DEFAULT_BRANCH" "$local_sha" 2>/dev/null) || base=""

  if [ -z "$base" ] || [ "$base" = "$local_sha" ]; then
    # No shared history, or nothing on top of the default branch: fall back to
    # whatever this push actually adds.
    [ "$remote_sha" = "$UNBORN" ] && continue
    base=$remote_sha
  fi

  git diff "$base..$local_sha" 2>/dev/null | "$HOOK_DIR/pii-scan" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "   Push aborted. Amend the commits so the data never reaches GitHub;"
  echo "   pushing first and removing later leaves it in the public history."
  echo ""
fi

exit $status
