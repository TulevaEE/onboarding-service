  0 - "Add the feature" "" "Explains why."
message_check "commit-msg leaves the diff below the scissors line to pre-commit" \
  0 - "Add the feature" "# ------------------------ >8 ------------------------" \
  "+String owner = \"$PII_FIXTURE_ID_CODE\";"

# The hooks fetch master without anyone at the keyboard, so the fetch must never
# prompt. A recording ssh shows how git was told to run it, and fails so that
# no network is ever reached.
make_ssh_recorder() {
  printf '#!/bin/sh\necho "args: $* prompt=${GIT_TERMINAL_PROMPT:-unset}" >>"%s"\nexit 1\n' \
    "$TMP/ssh-calls" >"$TMP/record-ssh"
  chmod +x "$TMP/record-ssh"
}

ssh_from_core_ssh_command() { git config core.sshCommand "$TMP/record-ssh"; }
ssh_from_git_ssh_command() { export GIT_SSH_COMMAND="$TMP/record-ssh"; }
ssh_from_git_ssh() { export GIT_SSH="$TMP/record-ssh"; }

# ssh_check <description> <contains|lacks> <text> <ssh setup>
ssh_check() {
  local description=$1 verdict=$2 text=$3 ssh_setup=$4
  setup_repo
  rm -f "$TMP/ssh-calls"
  make_ssh_recorder
  (
    unset GIT_SSH GIT_SSH_COMMAND
    "$ssh_setup"
    "$FETCH_MASTER" ssh://example.invalid/repo.git >/dev/null 2>&1
  )
  local calls actual=1
  calls=$(cat "$TMP/ssh-calls" 2>/dev/null)
  if [ -n "$calls" ]; then
    case "$verdict" in
      contains) printf '%s' "$calls" | grep -qF -- "$text" && actual=0 ;;
      lacks) printf '%s' "$calls" | grep -qF -- "$text" || actual=0 ;;
    esac
  fi
  expect_hook_result "$description" 0 - "$actual" "ssh calls: ${calls:-none}"
}

ssh_check "fetch-master runs the user's ssh command in batch mode" \
  contains "BatchMode=yes" ssh_from_core_ssh_command
ssh_check "fetch-master never lets git prompt for credentials" \
  contains "prompt=0" ssh_from_core_ssh_command
ssh_check "fetch-master leaves a GIT_SSH_COMMAND the user set alone" \
  lacks "BatchMode" ssh_from_git_ssh_command
ssh_check "fetch-master leaves a GIT_SSH the user set alone" \
  lacks "BatchMode" ssh_from_git_ssh

# Run on its own, migration-order fetches master from the remote it is told
# about rather than from whatever origin happens to be.
migration_order_remote_check() {
  setup_repo
  rm -rf "$TMP/origin.git"
  git init --quiet --bare "$TMP/origin.git"
  git -c core.hooksPath=/dev/null push --quiet "$TMP/origin.git" master
  git update-ref -d refs/remotes/origin/master
  git checkout --quiet -b feature
  echo "select 1;" >"$MIGRATION_DIR/V1_2__clash.sql"
  git add -A && git commit --quiet -m feature >/dev/null 2>&1
  local output actual
  output=$(MIGRATION_ORDER_REMOTE="$TMP/origin.git" "$HOOK" HEAD 2>&1)
  actual=$?
  expect_hook_result "migration-order fetches master from the remote it is given" \
    1 "V1_2__clash.sql" "$actual" "$output"
}

migration_order_remote_check

echo ""
if [ "$failed" -eq 0 ]; then
  echo "✅ migration-order: $passed checks passed"
  exit 0
fi
echo "❌ migration-order: $failed of $((passed + failed)) checks failed"
exit 1
