<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#FFFFFF" width="660px">
    <mj-include path="./partials/header.mjml" />

    <mj-section padding-top="12px">
      <mj-column>
        <mj-text>Tere,&nbsp;*|FNAME|*</mj-text>
        <mj-text>
          Sinu sissemakse ettevõtte Tuleva Täiendavasse Kogumisfondi on tehtud.
          *|IF:RECIPIENTNAME|*Saaja on *|RECIPIENTNAME|* ja osakud jõuavad ettevõtte kontole
          kahe tööpäeva jooksul.*|ELSE:|*Osakud jõuavad ettevõtte kontole kahe tööpäeva
          jooksul.*|END:IF|*
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column>
        <mj-raw>*|IF:suggestSavingsFundRecurringPayment|*</mj-raw>
        <mj-include path="./partials/suggest_savings_fund_recurring_et.mjml" />
        <mj-raw>*|END:IF|*</mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column>
        <mj-raw>*|IF:suggestSavingsFundRecurringPayment|*</mj-raw>
        <mj-text>
          Majandusaasta aruande jaoks vajalikud andmed leiad samuti oma OÜ Tuleva kontolt.
        </mj-text>
        <mj-raw>*|END:IF|*</mj-raw>
      </mj-column>
    </mj-section>

    <mj-include path="./partials/contact_et.mjml" />
    <mj-section padding="0 24px">
      <mj-column>
        <mj-text padding-top="12px">
          Tõnu Pekk<br />
          Tuleva asutaja ja fondijuht
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/disclaimer_savings_risk_et.mjml" />
    <mj-include path="./partials/footer_bottom_fund.mjml" />
  </mj-body>
</mjml>
