<mj-section padding="8px 24px 24px">
  <mj-column>
    <mj-divider />
    <mj-social mode="horizontal" align="center" icon-size="24px" icon-padding="8px" padding="8px 0">
      <mj-social-element
        href="https://tuleva.ee"
        src="https://cdn-images.mailchimp.com/icons/social-block-v3/block-icons-v3/website-icon-gray-40.png"
