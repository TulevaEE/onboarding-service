<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#FFFFFF" width="660px">
    <mj-include path="./partials/header.mjml" />

    <mj-section padding-top="12px">
      <mj-column>
        <mj-text>Hello *|FNAME|*</mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column
        border-left="4px solid #E5E5E5"
        background-color="#F8F9FA"
        border-radius="4px"
        padding="16px"
      >
        <mj-text font-style="italic" padding="0">*|message|*</mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          If you do not wish to proceed with the transaction, please let the interested seller
          know. If you no longer plan to buy membership capital, please delete your
          <a href="https://pension.tuleva.ee/capital/listings?language=en">listing</a>.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./partials/contact_en.mjml" />
    <mj-section padding="0 24px">
      <mj-column>
        <mj-text padding-top="12px">
          Members of the board of Tulundusühistu Tuleva<br />
          Annika Uudelepp and Tõnu Pekk
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer_bottom_coop.mjml" />
  </mj-body>
</mjml>
