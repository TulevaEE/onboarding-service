      />
      <mj-social-element
        href="https://www.facebook.com/Tuleva.ee"
        src="https://cdn-images.mailchimp.com/icons/social-block-v3/block-icons-v3/facebook-icon-gray-40.png"
        alt="Facebook icon"
      />
      <mj-social-element
        href="https://instagram.com/tulevafondid"
        src="https://cdn-images.mailchimp.com/icons/social-block-v3/block-icons-v3/instagram-icon-gray-40.png"
        alt="Instagram icon"
      />
      <mj-social-element
        href="https://open.spotify.com/show/2xkhKRzBNBa1JgC11okyCL"
