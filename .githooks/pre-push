#!/bin/bash
# On a public repository a push is publication, so personal data has to be
# stopped here rather than in CI: by the time a workflow runs, the branch is
# already on GitHub and a later commit cannot unpublish it.
#
# Only pii-scan fails the push. Git offers one --no-verify for the whole hook,
# so every further blocker here doubles as a reason to switch the PII scan off
# with it; anything CI can still catch afterwards only warns.

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNBORN=0000000000000000000000000000000000000000
DEFAULT_BRANCH=origin/master

pii_status=0
migration_status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$UNBORN" ] && continue

  # Compare against the merge base with the default branch, never against the
  # remote tip of this branch. Merging master in would otherwise re-present
  # every file master already carries as newly added, and the push would be
  # blocked by data that is long since public.
  base=$(git merge-base "$DEFAULT_BRANCH" "$local_sha" 2>/dev/null) || base=""

  if [ -z "$base" ] || [ "$base" = "$local_sha" ]; then
    # No shared history, or nothing on top of the default branch: fall back to
    # whatever this push actually adds.
    [ "$remote_sha" = "$UNBORN" ] && continue
    base=$remote_sha
  fi

  # The allowlists come from the pushed revision itself, so only an allowlist
  # entry that is being published can exempt an IBAN or ID code being
  # published.
  PII_IBAN_ALLOW_SOURCE=$(git show "$local_sha:.githooks/pii-iban-allow" 2>/dev/null || true)
  PII_IDCODE_ALLOW_SOURCE=$(git show "$local_sha:.githooks/pii-idcode-allow" 2>/dev/null || true)
  export PII_IBAN_ALLOW_SOURCE PII_IDCODE_ALLOW_SOURCE
  git diff "$base..$local_sha" 2>/dev/null | "$HOOK_DIR/pii-scan" || pii_status=1

  # Early notice, not a verdict: which versions are free is decided by whatever
  # merges first, so only the CircleCI job re-running against the new master can
  # settle it. Blocking here would buy nothing and cost the PII scan.
  "$HOOK_DIR/migration-order" "$local_sha" || migration_status=1
done

if [ "$migration_status" -ne 0 ]; then
  echo "⚠️  Not blocking the push: which versions are free is decided against"
  echo "   master as it stands at merge time, and the CircleCI migration-order"
  echo "   job fails the build until they are. Renumber before merging."
  echo ""
fi

if [ "$pii_status" -ne 0 ]; then
  echo "   Push aborted. Amend the commits so the data never reaches GitHub;"
  echo "   pushing first and removing later leaves it in the public history."
  echo ""
fi

exit $pii_status
