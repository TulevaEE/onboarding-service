<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#FFFFFF" width="660px">
    <mj-include path="./partials/header.mjml" />

    <mj-section padding-top="12px">
      <mj-column>
        <mj-text>Hello,&nbsp;*|FNAME|*</mj-text>
        <mj-text>Your II&nbsp;pillar applications have been submitted.</mj-text>
        <mj-text>
          Contributions to your II&nbsp;pillar will start again, and you get the tax win again.
        </mj-text>
        <mj-text><strong>Submitted applications:</strong></mj-text>
        <mj-text>Application to make contributions</mj-text>
        <mj-raw>*|IF:paymentRateChange|*</mj-raw>
        <mj-text>Contribution rate change application</mj-text>
        <mj-raw>*|END:IF|*</mj-raw>
        <mj-raw>*|IF:fundSelection|*</mj-raw>
        <mj-text>Fund selection application</mj-text>
        <mj-raw>*|END:IF|*</mj-raw>
        <mj-text>Contributions start on *|contributionStartDate|*.</mj-text>
        <mj-text>
          If you change your mind, you can cancel the application in your Tuleva account until
          *|cancellationDeadline|*.
        </mj-text>
        <mj-text>
          You can use the money from age 60. After rejoining, you can't stop contributions again
          or withdraw the money a second time.
        </mj-text>
        <mj-text>
          A copy of your applications, as sent to Pensionikeskus, is attached to this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./partials/contact_en.mjml" />
    <mj-section padding="0 24px">
      <mj-column>
        <mj-text padding-top="12px">Tuleva</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/disclaimer_second_pillar_rejoin_en.mjml" />
    <mj-include path="./partials/footer_bottom_fund.mjml" />
  </mj-body>
</mjml>
