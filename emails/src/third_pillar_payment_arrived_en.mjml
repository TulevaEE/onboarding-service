<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#FFFFFF" width="660px">
    <mj-include path="./partials/header.mjml" />

    <mj-section padding-top="12px">
      <mj-column>
        <mj-text>Hello,&nbsp;*|FNAME|*</mj-text>
        <mj-text>
          Your payment arrived on *|paymentDate|*. This puts you among
          the 30% of dedicated Estonians who save in the third pillar. The fund units are already
          in your pension account.
        </mj-text>

        <mj-raw>*|IF:hasTulevaUser|*</mj-raw>

        <mj-include path="./partials/suggest_chain_open_en.mjml" />

        <mj-raw>*|END:IF|*</mj-raw>

        <mj-raw>*|ELSE:|*</mj-raw>
        <mj-text>
          See all your savings in one place by logging in to Tuleva:
        </mj-text>
        <mj-button href="https://pension.tuleva.ee/login">Log in</mj-button>
        <mj-raw>*|END:IF|*</mj-raw>
      </mj-column>
    </mj-section>

    <mj-include path="./partials/contact_en.mjml" />
    <mj-section padding="0 24px">
      <mj-column>
        <mj-text padding-top="12px">
          Tõnu Pekk<br />
          Founder and fund manager of Tuleva
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/disclaimer_pension_en.mjml" />
    <mj-include path="./partials/footer_bottom_fund.mjml" />
  </mj-body>
</mjml>
